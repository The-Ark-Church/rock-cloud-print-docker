<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Rock.CloudPrint.Service</RootNamespace>
    <UserSecretsId>dotnet-CloudPrint-05389fc3-c69a-48e7-b6b1-d069ddb37771</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Polly.Core" Version="8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rock.CloudPrint.Shared\Rock.CloudPrint.Shared.csproj" />
  </ItemGroup>

  <!--
    Everything in this assembly is internal, and should stay that way - nothing
    outside it is a consumer. This lets the test project see those types without
    widening a single one of them to public. It emits an assembly attribute and
    changes no behaviour; Rock.CloudPrint.Shared already does the same for this
    project.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Rock.CloudPrint.Tests" />
  </ItemGroup>

</Project>
